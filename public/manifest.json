{
  "manifest_version": 3,
  "name": "Stale",
  "version": "0.1.0",
  "description": "Closes tabs you haven't touched in a while. Arc-style auto-archive for Chrome.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "alarms", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stale",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  }
}
